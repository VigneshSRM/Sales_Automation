# =============================================================================
# Infeara Sales OS — environment template (copy into your secret store)
# Nothing here is a default credential: every secret must be supplied.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
APP_ENV=production
APP_BASE_URL=https://sales.infeara.example
APP_TIMEZONE=Asia/Kolkata
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# --- Database (MariaDB 11.4, InnoDB, utf8mb4, UTC) -------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=infeara_sales
DB_USER=infeara_app
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN=4

# --- Encryption (AES-256-GCM for stored integration secrets) ---------------
# Generate: openssl rand -base64 32
SMTP_SECRET_ENCRYPTION_KEY=
SMTP_SECRET_ENCRYPTION_KEY_ID=k1
# Decrypt-only keys accepted during rotation, as id:key,... pairs
SMTP_SECRET_PREVIOUS_KEYS=

# --- Session, MFA, rate limiting -------------------------------------------
COOKIE_SECURE=true
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_WEBHOOK_PER_MINUTE=300

# --- First run bootstrap (leave the password empty to skip) ----------------
BOOTSTRAP_WORKSPACE_NAME=Infeara Technologies
BOOTSTRAP_WORKSPACE_SLUG=infeara
BOOTSTRAP_WORKSPACE_TIMEZONE=Asia/Kolkata
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Workspace Administrator

# --- Durable worker (Tomcat-hosted; MariaDB-backed leases) -----------------
WORKER_ENABLED=true
WORKER_INSTANCE_ID=
WORKER_TICK_INTERVAL_MS=5000

# --- Integrations ----------------------------------------------------------
# Calendly (release 4): subscription signing key is stored encrypted per connection;
# this env value is only the replay-tolerance fallback.
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_WEBHOOK_TOLERANCE_SECONDS=180

# --- AI providers (email triage, release 3b) --------------------------------
# Leave both keys empty to run with AI disabled: the inbox then shows "analysis not
# available" instead of a fabricated classification. There is no mock provider.
AI_PREFERRED_PROVIDER=OPENROUTER
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openai/gpt-4o-mini
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# --- Inbound mailbox sync (two-way email, release 3b) ----------------------
# Per-mailbox IMAP host/port/TLS/folder and the encrypted secret live in the database
# (Mailbox connections screen); these are the process-wide limits.
EMAIL_INBOUND_DISCOVERY_INTERVAL_MS=60000
EMAIL_INBOUND_MAX_BODY_CHARS=200000
EMAIL_INBOUND_MAX_ATTACHMENT_BYTES=10485760
EMAIL_INBOUND_MAX_ATTACHMENTS=20
EMAIL_INBOUND_MAX_MESSAGES_PER_SYNC=50
EMAIL_INBOUND_CONNECT_TIMEOUT_SECONDS=20
EMAIL_INBOUND_READ_TIMEOUT_SECONDS=60
# Outside these hours every reply needs human approval, whatever the rules say.
EMAIL_BUSINESS_HOURS_START=09:00
EMAIL_BUSINESS_HOURS_END=18:00

# --- CORS (empty = same-origin only, which is the supported deployment) ----
CORS_ALLOWED_ORIGINS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL_APP=INFO
