<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for Infeara Sales OS (Application Request Routing + URL Rewrite).

  Why IIS and not Tomcat's TLS connector: keeping TLS termination in IIS means one place holds
  the certificate, one place does HTTP-to-HTTPS redirects, and Tomcat stays on plain HTTP on
  localhost - which is exactly the shape the Linux deployment uses with nginx.

  Requirements on the web server:
      Install-WindowsFeature Web-Server, Web-WebSockets, Web-Mgmt-Console
      # IIS URL Rewrite 2.1 + Application Request Routing 3.0 (Web Platform Installer / MSI)
      # then, in IIS Manager -> server -> Application Request Routing Cache -> Server Proxy Settings:
      #     Enable proxy  = true
      #     Time-out      = 120 seconds
      #     Preserve host header = true
      # and, to let an unauthenticated SPA use large uploads:
      #     appcmd set config /section:requestFiltering /requestLimits.maxAllowedContentLength:12582912

  Place this file at C:\inetpub\wwwroot\web.config (or in a dedicated site root).

  The two headers that matter:
      X-Forwarded-Proto  -> the app marks the session cookie Secure only when this says https
      X-Forwarded-For    -> rate limiting and audit see the real client, not the proxy

  Getting X-Forwarded-Proto wrong is not cosmetic: with app.security.cookie-secure=auto and no
  forwarded scheme the cookie is issued without Secure (works, weaker), and with
  cookie-secure=always on a plain-HTTP connector every authenticated request returns 401
  because clients discard the cookie. Both behaviours are documented in
  docs/operations/windows-deployment.md.
-->
<configuration>
    <system.webServer>

        <rewrite>
            <rules>
                <!-- 1. Force HTTPS. HSTS is added as a response header below. -->
                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="off" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect"
                            url="https://{HTTP_HOST}/{R:1}"
                            redirectType="Permanent" />
                </rule>

                <!-- 2. Reverse proxy everything to Tomcat 11 on localhost:8080. -->
                <rule name="Infeara Sales OS to Tomcat" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite"
                            url="http://127.0.0.1:8080/{R:1}"
                            logRewrittenUrl="true" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                        <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                        <set name="HTTP_X_FORWARDED_PORT" value="443" />
                        <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
                        <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
                    </serverVariables>
                </rule>
            </rules>

            <!-- Let the rules above set server variables (IIS blocks this by default). -->
            <rewriteMaps />
        </rewrite>

        <!-- Required for the rules to write X-Forwarded-* server variables. -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="12582912" />
            </requestFiltering>
        </security>

        <!-- Do not let IIS answer API errors with its own HTML pages. -->
        <httpErrors existingResponse="PassThrough" />

        <!-- Static files are served by Tomcat inside the WAR; IIS must not shadow them. -->
        <staticContent>
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>

        <httpProtocol>
            <customHeaders>
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
